---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

type PostProps = { kind: 'post'; post: CollectionEntry<'blog'> };
type ArchiveProps = {
  kind: 'archive';
  page: number;
  posts: CollectionEntry<'blog'>[];
  pageCount: number;
};

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  const perPage = 10;
  const pageCount = Math.ceil(posts.length / perPage);

  return [
    ...posts.map((post) => ({
      params: { slug: post.data.slug },
      props: { kind: 'post', post } satisfies PostProps
    })),
    ...Array.from({ length: Math.max(0, pageCount - 1) }, (_, index) => {
      const page = index + 2;
      return {
        params: { slug: `page${page}` },
        props: {
          kind: 'archive',
          page,
          pageCount,
          posts: posts.slice((page - 1) * perPage, page * perPage)
        } satisfies ArchiveProps
      };
    })
  ];
}

const props = Astro.props as PostProps | ArchiveProps;
let post: CollectionEntry<'blog'> | undefined;
let Content: any;
let newer: CollectionEntry<'blog'> | undefined;
let older: CollectionEntry<'blog'> | undefined;
let readingMinutes = 0;

if (props.kind === 'post') {
  post = props.post;
  ({ Content } = await render(post));
  const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  const index = allPosts.findIndex((item) => item.id === post!.id);
  newer = allPosts[index - 1];
  older = allPosts[index + 1];

  // Prose only: fenced code is skimmed, not read at prose speed, so counting it
  // inflates the estimate on the more technical posts.
  const prose = (post.body ?? '').replace(/```[\s\S]*?```/g, ' ');
  readingMinutes = Math.max(1, Math.round(prose.split(/\s+/).filter(Boolean).length / 200));
}
---

{props.kind === 'archive' ? (
  <BaseLayout
    title={`Writing — page ${props.page}`}
    description={`Page ${props.page} of ${props.pageCount} of Marcos Placona's writing on programming, technology and independent products.`}
    canonicalPath={`/page${props.page}/`}
  >
    <section class="page-intro">
      <p class="eyebrow">WRITING ARCHIVE</p>
      <h1>Older writing.</h1>
      <p class="lede">Page {props.page} of {props.pageCount}.</p>
    </section>
    <section class="post-list" aria-label={`Writing archive page ${props.page}`}>
      {props.posts.map((post) => <PostCard post={post} />)}
    </section>
    <nav class="pagination" aria-label="Writing archive pages">
      {props.page > 2 && <a href={props.page === 3 ? '/page2/' : `/page${props.page - 1}/`}>← Newer</a>}
      {props.page < props.pageCount && <a href={`/page${props.page + 1}/`}>Older →</a>}
    </nav>
  </BaseLayout>
) : (
  <BaseLayout
    title={post!.data.title}
    seoTitle={post!.data.seoTitle}
    description={post!.data.description || `Read Marcos Placona’s article: ${post!.data.title}.`}
    image={post!.data.image}
    canonicalPath={`/${post!.data.slug}/`}
    type="article"
    publishedTime={post!.data.pubDate}
    categories={post!.data.categories}
  >
    <article class="post">
      <header class="post-header">
        <h1>{post!.data.title}</h1>
        {post!.data.description && <p class="lede">{post!.data.description}</p>}
        <p class="post-meta">
          <time datetime={post!.data.pubDate.toISOString().slice(0, 10)}>
            {post!.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
          </time>
          {post!.data.categories?.map((category) => <span class="chip">{category}</span>)}
          <span class="sep" aria-hidden="true">·</span>
          <span>{readingMinutes} min read</span>
        </p>
      </header>
      <div class="prose"><Content /></div>
      <nav class="article-nav" aria-label="Article navigation">
        {newer && (
          <a class="nav-prev" href={`/${newer.data.slug}/`} rel="prev">
            <span class="nav-label">← Newer</span>{newer.data.title}
          </a>
        )}
        {older && (
          <a class="nav-next" href={`/${older.data.slug}/`} rel="next">
            <span class="nav-label">Older →</span>{older.data.title}
          </a>
        )}
      </nav>
    </article>
  </BaseLayout>
)}
