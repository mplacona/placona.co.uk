---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { apps } from '../../data/apps';
---

<BaseLayout
  title="Independent apps"
  description="Small, local-first native iOS apps by Marcos Placona. One job done well, bought once, no subscription and no account."
  canonicalPath="/apps/"
>
  <section class="hero compact-hero">
    <p class="eyebrow">Independent apps</p>
    <h1>Useful software. No account circus.</h1>
    <p>Small native utilities, built to do one job well and then get out of your way.</p>
  </section>
  <section class="content-section app-grid">
    {apps.map((app) => (
      <article class="app-card">
        <p class="eyebrow">{app.status}</p>
        <h2><a href={`/apps/${app.slug}/`}>{app.name}</a></h2>
        <p class="app-tagline">{app.tagline}</p>
        <p>{app.description}</p>
        <a class="text-link" href={`/apps/${app.slug}/`}>See {app.name} <span aria-hidden="true">→</span></a>
      </article>
    ))}
  </section>
</BaseLayout>
