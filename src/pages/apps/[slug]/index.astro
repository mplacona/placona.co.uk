---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { apps } from '../../../data/apps';

export function getStaticPaths() {
  return apps.map((app) => ({ params: { slug: app.slug }, props: { app } }));
}
const { app } = Astro.props;
---

<BaseLayout title={`${app.name} — ${app.tagline}`} description={app.description} canonicalPath={`/apps/${app.slug}/`}>
  <article class="app-page">
    <section class="hero">
      {app.icon && <img class="app-icon" src={app.icon} alt={`${app.name} app icon`} width="128" height="128" />}
      <p class="eyebrow">{app.status}</p>
      {app.icon ? (
        <>
          <h1>{app.name}</h1>
          <p class="app-subtitle">{app.tagline}</p>
        </>
      ) : (
        <h1>{app.tagline}</h1>
      )}
      <p class="lede">{app.description}</p>
      {app.appStoreUrl ? (
        <a class="button-secondary" href={app.appStoreUrl}>Download on the App Store</a>
      ) : (
        <a class="button-secondary" href={`/apps/${app.slug}/support/`}>Get support</a>
      )}
    </section>
    <section class="content-section split-section">
      <div>
        <p class="eyebrow">What it does</p>
        <h2>{app.boundaryHeading}</h2>
      </div>
      <p>{app.boundary}</p>
    </section>
    {app.features && (
      <section class="content-section">
        <p class="eyebrow">Highlights</p>
        <ul class="feature-list">
          {app.features.map((feature) => <li>{feature}</li>)}
        </ul>
      </section>
    )}
    {app.relatedLinks && (
      <section class="content-section">
        <p class="eyebrow">Also useful</p>
        {app.relatedLinks.map((link) => (
          <div class="related-link">
            <h2><a href={link.href}>{link.label}</a></h2>
            <p>{link.description}</p>
          </div>
        ))}
      </section>
    )}
    <section class="content-section callout">
      <p class="eyebrow">Privacy</p>
      <h2>Private by design.</h2>
      <p>{app.privacy}</p>
      <a class="text-link" href={`/apps/${app.slug}/privacy/`}>Read the privacy page <span aria-hidden="true">→</span></a>
      {app.appStoreUrl && (
        <p><a class="text-link" href={`/apps/${app.slug}/support/`}>Get support <span aria-hidden="true">→</span></a></p>
      )}
    </section>
  </article>
</BaseLayout>

<style>
  .app-icon { display: block; width: 128px; height: 128px; margin-bottom: 1.25rem; border-radius: 22.5%; box-shadow: 0 0 0 1px var(--line); }
  .app-subtitle { margin: -0.25rem 0 1rem; font-size: 1.25rem; font-weight: 700; color: var(--ink-2); }
  .feature-list { margin: 0; padding-left: 1.25rem; max-width: 42rem; font-size: 1.1rem; line-height: 1.6; }
  .feature-list li + li { margin-top: 0.6rem; }
  .feature-list li::marker { color: var(--accent); }
  .related-link h2 { margin: 0 0 0.4rem; font-size: clamp(1.3rem, 2.3vw, 1.7rem); }
  .related-link p { margin: 0; max-width: 42rem; color: var(--ink-2); }
</style>
